<%
// Template for the lab members on people.qmd; the data is in people.yml.
// It outputs Markdown, so [text](url) links in bios work. Keep lines
// unindented: indented lines would be read as code blocks.
%>
::: {.people-list}
<% for (const p of items) {
  // anchor for linking to a person, e.g. people.html#atreya-choudhury
  const id = p.name.normalize("NFD").replace(/[\u0300-\u036f]/g, "")
    .toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
%>
::: {.person #<%= id %>}
::: {.person-photo}
<img src="<%= p.image %>" alt="<%= p.name %>">
:::
::: {.person-text}
<%
// The name is styled as a heading but is not an <h3>: Quarto's site search
// leaves heading text out of its index, so names would not be searchable.
%>
<div class="person-name h3" role="heading" aria-level="3"><%= p.name %></div>
<% if (p.links) { %>
::: {.person-links}
<% for (const l of p.links) { %>[<i class="bi bi-<%= l.icon %>"></i><%= l.text %>](<%= l.href %>) <% } %>
:::
<% } %>
<% if (p.bio) { %>
<%= p.bio %>
<% } %>
<% if (p.degrees) { %>
::: {.person-degrees}
<% for (const d of p.degrees) { %>
<%= d %>

<% } %>
:::
<% } %>
:::
:::
<% } %>
:::
